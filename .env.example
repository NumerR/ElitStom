# DentaCore API — local development environment.
# Copy to .env and adjust. .env is git-ignored and loaded only by cmd/api.

# --- Application ---
APP_ENV=development

# --- HTTP ---
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s

# --- Logging ---
# LOG_LEVEL: debug | info | warn | error (slog syntax, offsets like info+2 allowed)
LOG_LEVEL=debug
# LOG_FORMAT: json | text
LOG_FORMAT=text

# --- PostgreSQL ---
# Either set DATABASE_URL, or the discrete PG_* values below. DATABASE_URL wins.
# DATABASE_URL=postgres://dentacore:dentacore@localhost:5432/dentacore?sslmode=disable
PG_HOST=localhost
PG_PORT=5432
PG_USER=dentacore
PG_PASSWORD=dentacore
PG_DATABASE=dentacore
# PG_SSLMODE must not be "disable" when APP_ENV=production
PG_SSLMODE=disable
PG_POOL_MAX_CONNS=10
PG_POOL_MIN_CONNS=0
PG_CONN_MAX_LIFETIME=1h
PG_CONN_MAX_IDLE_TIME=15m
PG_CONNECT_TIMEOUT=5s
# PG_STATEMENT_TIMEOUT is enforced by PostgreSQL on every pooled connection, so a query is
# bounded even if a handler forgets its deadline. 0 disables the server-side limit.
PG_STATEMENT_TIMEOUT=5s

# --- Auth ---
# JWT_SECRET signs access tokens (HS256). Minimum 32 bytes; generate a fresh one per
# environment and never commit the real value:
#   openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-32-bytes-of-random-data
# Access tokens stay short-lived; the refresh token TTL sets how long a session survives
# without activity. JWT_REFRESH_TTL must exceed JWT_ACCESS_TTL.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
JWT_ISSUER=dentacore
JWT_AUDIENCE=dentacore-api
# BCRYPT_COST: 10..15. 12 is ~80ms per login on one core; raise it only after measuring.
BCRYPT_COST=12
